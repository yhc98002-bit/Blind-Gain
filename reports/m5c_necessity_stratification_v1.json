{
  "adopted_definitions": {
    "primary": {
      "label_caveat": "Gate 0 never attached the words blind-solvable / image-necessary to these terciles; it called them low/mid/high \u0394q. The low-\u0394q bin means 'the image bought no measured reward opportunity', which is satisfied both by items the base model solves blind and by items it solves under no condition. q_blind and q_real are reported per bin so this is visible.",
      "label_map": {
        "bin0_low_delta_q": "blind_solvable",
        "bin1_mid_delta_q": "intermediate",
        "bin2_high_delta_q": "image_necessary"
      },
      "name": "delta_q terciles (Gate 0 G0.1)",
      "operational_rule": "q_real = q_i from the guarded-rescore `real` per_item.jsonl; q_blind = q_i from the guarded-rescore `none` per_item.jsonl (base model, Jeffreys-smoothed). delta_q = q_real - q_blind. Bin edges = np.quantile(delta_q, [0,1/3,2/3,1]) with the outer edges opened to +/-inf; bin 0 is delta_q <= e1, bin i>0 is e_i < delta_q <= e_{i+1}. Identical code path to Gate 0.",
      "quote_from_gate0_docstring": "Delta-q uses the audit's own per-item q_i, real minus none, on the identical rows.",
      "quote_from_gate0_md": "\u0394q = q_real \u2212 q_blind per item, taken from the registered blind reward-opportunity audit's own `q_i`. Terciles of \u0394q, mean per-item image-present gain in each",
      "source_code": "scripts/build_gate0_stratification.py (function `concentration`, n_bins=3)",
      "source_report": "reports/gate0_stratification_v1.md"
    },
    "secondary": {
      "name": "blind-answerable split (Gate 0 G0.2 headroom control)",
      "operational_rule": "FLOOR = min(q_blind) over the 601 eval items; blind_answerable = q_blind > FLOOR + 1e-9.",
      "quote_from_gate0_md": "`q_blind` is Jeffreys-smoothed, so items with no observed blind success sit at the floor 0.1387. The split is therefore **blind-answerable** (\u22651 observed blind success, n=117) versus **not** (n=484).",
      "source_code": "scripts/build_g02_headroom_control.py lines 39-42",
      "source_report": "reports/gate0_stratification_v1.md",
      "why_reported": "This is Gate 0's only literal 'blind-solvable' definition. It is binary, so it cannot produce an 'intermediate' bin; it is reported alongside, not merged (I13)."
    }
  },
